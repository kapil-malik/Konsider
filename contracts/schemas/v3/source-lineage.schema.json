{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/source-lineage.schema.json",
  "title": "Replayable multiple-source lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["lineage_id", "lineage_version", "sources", "transforms"],
  "properties": {
    "lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "lineage_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceInput"
      }
    },
    "transforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transform"
      }
    }
  },
  "$defs": {
    "sourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "role",
        "source_version",
        "asset_uri",
        "checksum",
        "licence_id"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "PRIMARY_OBSERVATION",
            "ENTITY_UNIVERSE",
            "BOUNDARY",
            "AUXILIARY",
            "SCORING_INPUT"
          ]
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "asset_uri": {
          "type": "string",
          "minLength": 1
        },
        "checksum": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "licence_id": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": ["string", "null"]
        },
        "dataset_version": {
          "type": ["string", "null"]
        },
        "canonical_page_url": {
          "type": ["string", "null"]
        },
        "attribution": {
          "type": ["string", "null"]
        },
        "reference_period": {
          "type": ["string", "null"]
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_version", "role"],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "PRIMARY_OBSERVATION",
            "ENTITY_UNIVERSE",
            "BOUNDARY",
            "AUXILIARY",
            "SCORING_INPUT"
          ]
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "transform_version",
        "input_refs",
        "output_ref"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "transform_version": {
          "type": "string",
          "minLength": 1
        },
        "input_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "output_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
