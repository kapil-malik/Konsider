{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/opportunity-filter-evidence-policy.schema.json",
  "title": "Opportunity Filter evidence policy 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "public_states",
    "eligibility_state",
    "combination",
    "precedence",
    "negative_integrity",
    "missing_record_behavior"
  ],
  "properties": {
    "schema_version": {"const": "opportunity-filter-evidence-policy-1.0"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "public_states": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "prefixItems": [
        {"const": "VERIFIED_STRONG_SIGNAL"},
        {"const": "STRONG_SIGNAL_NOT_ESTABLISHED"},
        {"const": "INSUFFICIENT_EVIDENCE"}
      ]
    },
    "eligibility_state": {"const": "VERIFIED_STRONG_SIGNAL"},
    "combination": {"const": "ALL_SELECTED_REQUIRED"},
    "precedence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "negative_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_complete_evidence", "partial_source_can_establish_negative", "source_absence_state"],
      "properties": {
        "requires_complete_evidence": {"const": true},
        "partial_source_can_establish_negative": {"const": false},
        "source_absence_state": {"const": "INSUFFICIENT_EVIDENCE"}
      }
    },
    "missing_record_behavior": {"const": "REJECT_RELEASE_NO_RUNTIME_INFERENCE"}
  }
}
