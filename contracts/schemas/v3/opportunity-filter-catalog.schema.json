{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/opportunity-filter-catalog.schema.json",
  "title": "Opportunity Filter catalog 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compatible_release_schema_major",
    "stable_universe_id",
    "activation_status",
    "state_contract_version",
    "definitions"
  ],
  "properties": {
    "schema_version": {"const": "opportunity-filter-catalog-1.0"},
    "compatible_release_schema_major": {"const": 5},
    "stable_universe_id": {"type": "string", "minLength": 1},
    "activation_status": {"enum": ["STAGED_CONTRACT_ONLY", "ACTIVE"]},
    "state_contract_version": {"const": "opportunity-filter-state-1.0"},
    "definitions": {
      "type": "array",
      "maxItems": 9,
      "items": {"$ref": "opportunity-filter-definition.schema.json"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"activation_status": {"const": "ACTIVE"}}, "required": ["activation_status"]},
      "then": {"properties": {"definitions": {"minItems": 9, "maxItems": 9}}}
    }
  ]
}
