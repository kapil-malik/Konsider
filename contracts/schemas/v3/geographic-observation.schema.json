{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/geographic-observation.schema.json",
  "title": "Entity-neutral geographic observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "criterion_id",
    "subject",
    "value",
    "unit",
    "reference_period",
    "source_lineage_id",
    "quality_flags"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "$ref": "geographic-entity.schema.json#/$defs/entityReference"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "reference_period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "source_lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    }
  }
}
