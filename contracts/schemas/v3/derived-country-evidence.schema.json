{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/derived-country-evidence.schema.json",
  "title": "Replayable locality-derived country evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "result_criterion_id",
    "country",
    "derivation_method",
    "aggregation_policy",
    "input_release_id",
    "result_observation_id",
    "result_score_id",
    "contributing_localities",
    "eligible_locality_count",
    "valid_locality_count",
    "result_score",
    "criterion_source_lineage_id",
    "quality_flags"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "result_criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "country": {
      "allOf": [
        {
          "$ref": "geographic-entity.schema.json#/$defs/entityReference"
        },
        {
          "properties": {
            "entity_type": {
              "const": "COUNTRY"
            }
          }
        }
      ]
    },
    "derivation_method": {
      "const": "AGGREGATED_FROM_LOCALITIES"
    },
    "aggregation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "policy_version"],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+$"
        }
      }
    },
    "input_release_id": {
      "type": "string",
      "minLength": 1
    },
    "result_observation_id": {
      "type": "string",
      "minLength": 1
    },
    "result_score_id": {
      "type": "string",
      "minLength": 1
    },
    "contributing_localities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locality", "observation_ids", "score_id", "score"],
        "properties": {
          "locality": {
            "$ref": "geographic-entity.schema.json#/$defs/localityReference"
          },
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "score_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        }
      }
    },
    "eligible_locality_count": {
      "type": "integer",
      "minimum": 1
    },
    "valid_locality_count": {
      "type": "integer",
      "minimum": 1
    },
    "result_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "criterion_source_lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "quality_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "COMPLETE_LOCALITY_INPUTS",
          "PARTIAL_LOCALITY_INPUTS",
          "SINGLE_LOCALITY_RESULT",
          "SOURCE_METHOD_CLARIFICATION_PENDING",
          "FEWER_THAN_N_AVAILABLE",
          "BOUNDARY_TIES_INCLUDED",
          "OUTSIDE_UNIVERSE_INPUT_IGNORED",
          "STALE_LOCALITY_INPUT_IGNORED",
          "INVALID_LOCALITY_INPUT_IGNORED"
        ]
      }
    }
  }
}
