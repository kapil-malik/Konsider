{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/ranking-response.schema.json",
  "title": "Target API v2 structured ranking response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_contract_version",
    "release_id",
    "release_schema_version",
    "catalog_schema_version",
    "resolved_preference_preset_id",
    "normalized_weights",
    "assessments",
    "rankings"
  ],
  "properties": {
    "api_contract_version": {
      "const": "konsider-api-2.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "release_schema_version": {
      "type": "string",
      "pattern": "^konsider-release-5\\.[0-9]+$"
    },
    "catalog_schema_version": {
      "type": "string",
      "pattern": "^consumer-catalog-3\\.[0-9]+$"
    },
    "resolved_preference_preset_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "normalized_weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "locality", "profile"],
      "properties": {
        "coverage": {
          "$ref": "#/$defs/coverageAssessment"
        },
        "locality": {
          "$ref": "#/$defs/responseLocalityAssessment"
        },
        "profile": {
          "$ref": "#/$defs/profileAssessment"
        }
      }
    },
    "rankings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rankedCountry"
      }
    }
  },
  "$defs": {
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "effect"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Za-z0-9_.-]+)?$"
        },
        "severity": {
          "enum": ["INFO", "WARNING", "BLOCKER"]
        },
        "effect": {
          "enum": [
            "NONE",
            "ADVISORY",
            "COUNTRY_EXCLUDED",
            "RANKING_FALLBACK",
            "NOT_EVALUATED"
          ]
        }
      }
    },
    "coverageAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy_version",
        "active_global_core_criterion_ids",
        "active_conditional_criterion_ids",
        "excluded_country_entity_ids",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "NO_PARTIAL_CRITERIA_ACTIVE",
            "FULL_COVERAGE",
            "PARTIAL_COMPLETE_CASE",
            "COVERAGE_LIMIT_FALLBACK"
          ]
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "active_global_core_criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "active_conditional_criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_country_entity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^country:[A-Z]{3}$"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "localityStatus": {
      "enum": [
        "NO_ACTIVE_LOCALITY_CRITERIA",
        "BELOW_ANALYSIS_THRESHOLD",
        "ONE_ACTIVE_LOCALITY_CRITERION",
        "COMMON_LOCALITY_AVAILABLE",
        "PARTIAL_OVERLAP",
        "NO_COMMON_LOCALITY",
        "INSUFFICIENT_LOCALITY_EVIDENCE",
        "MIXED_COUNTRY_RESULTS"
      ]
    },
    "responseLocalityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policy_version",
        "contributing_criterion_ids",
        "analysis_triggered_criterion_ids",
        "below_threshold_criterion_ids",
        "analysis_thresholds",
        "aggregation_policy_ids",
        "excluded_country_assessments",
        "reasons"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/responseLocalityStatus"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        },
        "contributing_criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "analysis_triggered_criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "below_threshold_criterion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "analysis_thresholds": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "aggregation_policy_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded_country_assessments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/excludedCountryLocalityAssessment"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "countryLocalityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "eligible_locality_entity_ids",
        "valid_locality_entity_ids",
        "contributing_locality_entity_ids",
        "common_locality_entity_ids",
        "best_common_locality_entity_id",
        "criterion_evidence",
        "reasons"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/localityStatus"
        },
        "eligible_locality_entity_ids": {
          "$ref": "#/$defs/localityIds"
        },
        "valid_locality_entity_ids": {
          "$ref": "#/$defs/localityIds"
        },
        "contributing_locality_entity_ids": {
          "$ref": "#/$defs/localityIds"
        },
        "common_locality_entity_ids": {
          "$ref": "#/$defs/localityIds"
        },
        "best_common_locality_entity_id": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]+$"
        },
        "criterion_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterionLocalityEvidence"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "responseLocalityStatus": {
      "enum": [
        "NO_ACTIVE_LOCALITY_CRITERIA",
        "BELOW_ANALYSIS_THRESHOLD",
        "ONE_ACTIVE_LOCALITY_CRITERION",
        "COMMON_LOCALITY_AVAILABLE",
        "PARTIAL_OVERLAP",
        "NO_COMMON_LOCALITY",
        "INSUFFICIENT_LOCALITY_EVIDENCE",
        "MIXED_COUNTRY_RESULTS"
      ]
    },
    "profileAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluated_dimensions", "reasons"],
      "properties": {
        "status": {
          "enum": ["NO_PROFILE_CONTEXT", "NOT_EVALUATED", "EVALUATED"]
        },
        "evaluated_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    "rankedCountry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "country",
        "total_score",
        "contributions",
        "assessments"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "country": {
          "allOf": [
            {
              "$ref": "geographic-entity.schema.json#/$defs/entityReference"
            },
            {
              "properties": {
                "entity_type": {
                  "const": "COUNTRY"
                }
              }
            }
          ]
        },
        "total_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "contributions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "assessments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["locality", "profile"],
          "properties": {
            "locality": {
              "$ref": "#/$defs/countryLocalityAssessment"
            },
            "profile": {
              "$ref": "#/$defs/profileAssessment"
            }
          }
        }
      }
    },
    "localityIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]+$"
      }
    },
    "criterionLocalityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "eligible_locality_entity_ids",
        "valid_locality_entity_ids",
        "contributing_locality_entity_ids"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "eligible_locality_entity_ids": {
          "$ref": "#/$defs/localityIds"
        },
        "valid_locality_entity_ids": {
          "$ref": "#/$defs/localityIds"
        },
        "contributing_locality_entity_ids": {
          "$ref": "#/$defs/localityIds"
        }
      }
    },
    "excludedCountryLocalityAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country", "assessment"],
      "properties": {
        "country": {
          "allOf": [
            {
              "$ref": "geographic-entity.schema.json#/$defs/entityReference"
            },
            {
              "properties": {
                "entity_type": {
                  "const": "COUNTRY"
                }
              }
            }
          ]
        },
        "assessment": {
          "$ref": "#/$defs/countryLocalityAssessment"
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "score",
        "normalized_weight",
        "contribution",
        "observation_id",
        "score_id",
        "evidence_kind",
        "derived_evidence_id"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "normalized_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "contribution": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "observation_id": {
          "type": "string",
          "minLength": 1
        },
        "score_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": ["DIRECT_OBSERVATION", "DERIVED_LOCALITIES"]
        },
        "derived_evidence_id": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_kind": {
                "const": "DIRECT_OBSERVATION"
              }
            },
            "required": ["evidence_kind"]
          },
          "then": {
            "properties": {
              "derived_evidence_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "derived_evidence_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
