{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/criterion-policy.schema.json",
  "title": "Replayable criterion ingestion policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "criterion_id",
    "source_lineage_ids",
    "parser",
    "scoring",
    "coverage_mode",
    "scope",
    "derivation",
    "applicability",
    "ready",
    "experimental"
  ],
  "properties": {
    "criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "source_lineage_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parser": {
      "$ref": "#/$defs/versionedProcessor"
    },
    "scoring": {
      "$ref": "#/$defs/versionedProcessor"
    },
    "coverage_mode": {
      "enum": ["GLOBAL_CORE", "CONDITIONAL_COMPLETE_CASE", "DIAGNOSTIC_ONLY"]
    },
    "scope": {
      "$ref": "criterion-definition.schema.json#/$defs/scope"
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "processor"],
      "properties": {
        "mode": {
          "enum": ["DIRECT", "AGGREGATED_FROM_LOCALITIES"]
        },
        "processor": {
          "oneOf": [
            {
              "$ref": "#/$defs/versionedProcessor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "DIRECT"
              }
            },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "processor": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "processor": {
                "$ref": "#/$defs/versionedProcessor"
              }
            }
          }
        }
      ]
    },
    "applicability": {
      "$ref": "criterion-definition.schema.json#/$defs/applicability"
    },
    "ready": {
      "type": "boolean"
    },
    "experimental": {
      "type": "boolean"
    }
  },
  "$defs": {
    "versionedProcessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
