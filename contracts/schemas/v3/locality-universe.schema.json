{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/locality-universe.schema.json",
  "title": "Versioned locality universe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "locality_universe_id",
    "locality_universe_version",
    "locality_type",
    "source_lineage_id",
    "selection",
    "country_treatment",
    "entity_ids"
  ],
  "properties": {
    "locality_universe_id": {
      "type": "string",
      "minLength": 1
    },
    "locality_universe_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "locality_type": {
      "enum": ["CITY", "METRO", "REGION", "SERVICE_AREA"]
    },
    "source_lineage_id": {
      "type": "string",
      "minLength": 1
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "minimum_population",
        "maximum_per_country",
        "order_by",
        "order_direction",
        "tie_breakers",
        "independent_of_criterion_values"
      ],
      "properties": {
        "method": {
          "enum": ["BOUNDED_POPULATION"]
        },
        "minimum_population": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "maximum_per_country": {
          "type": "integer",
          "minimum": 1
        },
        "order_by": {
          "type": "string",
          "minLength": 1
        },
        "order_direction": {
          "enum": ["ASC", "DESC"]
        },
        "tie_breakers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "independent_of_criterion_values": {
          "const": true
        }
      }
    },
    "country_treatment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_qualifying_locality",
        "single_locality",
        "cross_border"
      ],
      "properties": {
        "no_qualifying_locality": {
          "const": "EXPLICIT_NO_LOCALITY_OUTCOME"
        },
        "single_locality": {
          "const": "ALLOW_POLICY_TO_DECIDE"
        },
        "cross_border": {
          "enum": [
            "SOURCE_PARENT_COUNTRY_V1",
            "EXPLICIT_MULTI_COUNTRY_ENTITY"
          ]
        }
      }
    },
    "entity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
