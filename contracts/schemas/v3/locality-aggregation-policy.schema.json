{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v3/locality-aggregation-policy.schema.json",
  "title": "Versioned locality-to-country aggregation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "policy_version",
    "eligible_locality_universe",
    "source_criterion_id",
    "result_criterion_id",
    "locality_type",
    "result_level",
    "selection",
    "minimum_valid_localities",
    "score_range",
    "tie_handling",
    "one_locality_treatment",
    "required_lineage_roles"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+$"
    },
    "eligible_locality_universe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locality_universe_id", "locality_universe_version"],
      "properties": {
        "locality_universe_id": {
          "type": "string",
          "minLength": 1
        },
        "locality_universe_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.[0-9]+$"
        }
      }
    },
    "source_criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "result_criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "locality_type": {
      "enum": ["CITY", "METRO", "REGION", "SERVICE_AREA"]
    },
    "result_level": {
      "const": "COUNTRY"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "n"],
      "properties": {
        "method": {
          "enum": ["TOP_N_MEAN", "BOTTOM_N_MEAN", "ALL_VALID_MEAN"]
        },
        "n": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "ALL_VALID_MEAN"
              }
            },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "n": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "minimum_valid_localities": {
      "type": "integer",
      "minimum": 1
    },
    "score_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "tie_handling": {
      "enum": [
        "STABLE_ENTITY_ID",
        "INCLUDE_ALL_AT_BOUNDARY",
        "FAIL_AMBIGUOUS"
      ]
    },
    "one_locality_treatment": {
      "enum": ["USE_AVAILABLE", "INSUFFICIENT_EVIDENCE"]
    },
    "required_lineage_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PRIMARY_OBSERVATION",
          "ENTITY_UNIVERSE",
          "BOUNDARY",
          "AUXILIARY",
          "SCORING_INPUT"
        ]
      }
    }
  }
}
