{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v4/tfc-common.schema.json",
  "title": "Phase 7 TFC common definitions",
  "$defs": {
    "countryCode": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "currencyCode": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "fieldId": {"type": "string", "pattern": "^(applicant|household|scenario)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
    "tfcId": {"enum": ["skilled_work_route_feasibility", "family_accompaniment_reunification", "post_study_work_pathway"]},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "captured_at"],
      "properties": {
        "source": {"enum": ["USER_SUPPLIED", "IMPORTED", "DERIVED"]},
        "captured_at": {"type": "string", "format": "date-time"},
        "derived_from": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/fieldId"}}
      }
    },
    "taxonomyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_text", "mapping_state"],
      "properties": {
        "user_text": {"type": "string", "minLength": 1, "maxLength": 200},
        "taxonomy_id": {"type": ["string", "null"], "minLength": 1},
        "taxonomy_version": {"type": ["string", "null"], "minLength": 1},
        "code": {"type": ["string", "null"], "minLength": 1},
        "mapping_state": {"enum": ["MAPPED", "UNRESOLVED", "UNKNOWN"]}
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "period"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"$ref": "#/$defs/currencyCode"},
        "period": {"enum": ["HOURLY", "MONTHLY", "ANNUAL"]}
      }
    },
    "retentionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "consent", "policy_version", "expires_at"],
      "properties": {
        "mode": {"enum": ["TAB_MEMORY_ONLY", "DEVICE_WITH_EXPLICIT_CONSENT"]},
        "consent": {"enum": ["NOT_REQUESTED", "DECLINED", "GRANTED"]},
        "policy_version": {"const": "profile-retention-policy-1.0"},
        "consented_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "TAB_MEMORY_ONLY"}}},
          "then": {"properties": {"consent": {"enum": ["NOT_REQUESTED", "DECLINED"]}, "consented_at": {"type": "null"}, "expires_at": {"type": "null"}}}
        },
        {
          "if": {"properties": {"mode": {"const": "DEVICE_WITH_EXPLICIT_CONSENT"}}},
          "then": {"properties": {"consent": {"const": "GRANTED"}, "consented_at": {"type": "string"}, "expires_at": {"type": "string"}}, "required": ["consented_at"]}
        }
      ]
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "asset_id", "effective_from", "effective_to", "captured_at", "checksum"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string", "format": "date"},
        "effective_to": {"type": ["string", "null"], "format": "date"},
        "captured_at": {"type": "string", "format": "date-time"},
        "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "routeCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "label", "field_ids"],
      "properties": {
        "condition_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "label": {"type": "string", "minLength": 1},
        "field_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/fieldId"}}
      }
    }
  }
}
