{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v4/tfc-route-result.schema.json",
  "title": "TFC route/rule result 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "match_classification", "supported_routes_evaluated", "matched_route_ids", "route_inventory_complete", "met_conditions", "unmet_conditions", "unknown_conditions", "blocking_conditions", "evidence", "caveats", "legal_impossibility_disclaimer"],
  "properties": {
    "schema_version": {"const": "tfc-route-result-1.0"},
    "match_classification": {"enum": ["SUPPORTED_ROUTE_MATCH", "CONDITIONAL_ROUTE_MATCH", "NO_SUPPORTED_ROUTE_MATCH"]},
    "supported_routes_evaluated": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "route_name", "authority_id"],
        "properties": {
          "route_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
          "route_name": {"type": "string", "minLength": 1},
          "authority_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "matched_route_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"}},
    "route_inventory_complete": {"type": "boolean"},
    "met_conditions": {"type": "array", "items": {"$ref": "tfc-common.schema.json#/$defs/routeCondition"}},
    "unmet_conditions": {"type": "array", "items": {"$ref": "tfc-common.schema.json#/$defs/routeCondition"}},
    "unknown_conditions": {"type": "array", "items": {"$ref": "tfc-common.schema.json#/$defs/routeCondition"}},
    "blocking_conditions": {"type": "array", "items": {"$ref": "tfc-common.schema.json#/$defs/routeCondition"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "tfc-common.schema.json#/$defs/evidenceReference"}},
    "caveats": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "legal_impossibility_disclaimer": {"const": "No supported-route match is not a permanent legal impossibility."}
  }
}
