{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v4/exploration-scenario.schema.json",
  "title": "ExplorationScenario 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "target_date", "target_country_codes", "target_region_ids", "selected_tfc_ids", "feasibility_filter_mode", "relocation_composition", "unknown_fields", "field_provenance"],
  "properties": {
    "schema_version": {"const": "exploration-scenario-1.0"},
    "scenario_id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"},
    "purpose": {"enum": ["WORK", "STUDY", "FAMILY", "EXPLORATION"]},
    "target_date": {"type": "string", "format": "date"},
    "target_country_codes": {"type": "array", "minItems": 1, "maxItems": 91, "uniqueItems": true, "items": {"$ref": "tfc-common.schema.json#/$defs/countryCode"}},
    "target_region_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^region:[A-Za-z0-9._-]+$"}},
    "target_locality_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(city|metro):[A-Za-z0-9._-]+$"}},
    "job_offer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["state", "role", "employer_region_id", "sponsorship_state", "salary"],
      "properties": {
        "state": {"enum": ["PRESENT", "ABSENT", "UNKNOWN"]},
        "role": {"type": ["string", "null"], "maxLength": 200},
        "employer_region_id": {"type": ["string", "null"], "maxLength": 120},
        "sponsorship_state": {"enum": ["CONFIRMED", "NOT_CONFIRMED", "NOT_APPLICABLE", "UNKNOWN"]},
        "salary": {"oneOf": [{"$ref": "tfc-common.schema.json#/$defs/money"}, {"type": "null"}]}
      }
    },
    "intended_occupation": {"oneOf": [{"$ref": "tfc-common.schema.json#/$defs/taxonomyReference"}, {"type": "null"}]},
    "intended_study": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["institution", "qualification_level", "field", "duration_months", "mode", "completion_date", "completion_state"],
      "properties": {
        "institution": {"$ref": "tfc-common.schema.json#/$defs/taxonomyReference"},
        "qualification_level": {"enum": ["VOCATIONAL", "BACHELORS", "MASTERS", "DOCTORATE", "OTHER", "UNKNOWN"]},
        "field": {"$ref": "tfc-common.schema.json#/$defs/taxonomyReference"},
        "duration_months": {"type": "integer", "minimum": 1, "maximum": 120},
        "mode": {"enum": ["IN_PERSON", "HYBRID", "ONLINE", "UNKNOWN"]},
        "completion_date": {"type": "string", "format": "date"},
        "completion_state": {"enum": ["COMPLETED", "CURRENT", "PLANNED"]}
      }
    },
    "primary_route_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]+$"},
    "housing_assumptions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["tenure", "bedrooms", "furnished"],
      "properties": {
        "tenure": {"enum": ["RENT", "BUY", "UNDECIDED"]},
        "bedrooms": {"type": ["integer", "null"], "minimum": 0, "maximum": 8},
        "furnished": {"type": ["boolean", "null"]}
      }
    },
    "budget_assumptions": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["monthly_budget", "income_basis"],
      "properties": {
        "monthly_budget": {"oneOf": [{"$ref": "tfc-common.schema.json#/$defs/money"}, {"type": "null"}]},
        "income_basis": {"enum": ["GROSS", "NET", "UNKNOWN"]}
      }
    },
    "relocation_composition": {"enum": ["APPLICANT_ONLY", "WITH_PARTNER", "WITH_DEPENDANTS", "WITH_PARTNER_AND_DEPENDANTS", "UNKNOWN"]},
    "selected_tfc_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "tfc-common.schema.json#/$defs/tfcId"}},
    "feasibility_filter_mode": {"enum": ["ASSESSMENT_ONLY", "EXPLICIT_SUPPORTED_ROUTE_FILTER"]},
    "unknown_fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "tfc-common.schema.json#/$defs/fieldId"}},
    "field_provenance": {"type": "object", "additionalProperties": {"$ref": "tfc-common.schema.json#/$defs/provenance"}}
  }
}
