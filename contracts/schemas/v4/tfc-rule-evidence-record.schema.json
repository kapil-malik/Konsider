{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v4/tfc-rule-evidence-record.schema.json",
  "title": "Typed TFC destination rule and evidence record 1.0",
  "oneOf": [
    {"$ref": "#/$defs/jurisdiction"},
    {"$ref": "#/$defs/support"},
    {"$ref": "#/$defs/routeRule"},
    {"$ref": "#/$defs/metricFormula"}
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": ["schema_version", "record_id", "record_type"],
      "properties": {
        "schema_version": {"const": "tfc-rule-evidence-record-1.0"},
        "record_id": {"type": "string", "pattern": "^[a-z][A-Za-z0-9:._-]+$"},
        "record_type": {"enum": ["JURISDICTION", "DESTINATION_SUPPORT", "ROUTE_RULE", "METRIC_FORMULA"]}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effective_from", "effective_to", "source_published_at", "verified_at", "stale_after", "supersedes_record_id", "conflict_status"],
      "properties": {
        "effective_from": {"type": "string", "format": "date"},
        "effective_to": {"type": ["string", "null"], "format": "date"},
        "source_published_at": {"type": ["string", "null"], "format": "date"},
        "verified_at": {"type": "string", "format": "date"},
        "stale_after": {"type": "string", "format": "date"},
        "supersedes_record_id": {"type": ["string", "null"], "pattern": "^[a-z][A-Za-z0-9:._-]+$"},
        "conflict_status": {"enum": ["NONE", "RESOLVED", "UNRESOLVED"]},
        "conflict_resolution": {"type": ["string", "null"]}
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "asset_id", "locator"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "asset_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "jurisdiction": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "record_id", "record_type", "jurisdiction_id", "level", "country_code", "parent_jurisdiction_id", "name", "mapping_status"],
          "properties": {
            "schema_version": {"const": "tfc-rule-evidence-record-1.0"},
            "record_id": {"type": "string"},
            "record_type": {"const": "JURISDICTION"},
            "jurisdiction_id": {"type": "string", "pattern": "^(country|region|city|institution|regulator):[A-Za-z0-9._-]+$"},
            "level": {"enum": ["COUNTRY", "REGION", "CITY", "INSTITUTION", "REGULATOR"]},
            "country_code": {"$ref": "tfc-common.schema.json#/$defs/countryCode"},
            "parent_jurisdiction_id": {"type": ["string", "null"]},
            "name": {"type": "string", "minLength": 1},
            "mapping_status": {"enum": ["ACTIVE", "UNSUPPORTED"]}
          }
        }
      ]
    },
    "support": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "record_id", "record_type", "tfc_id", "country_code", "support_status", "jurisdiction_ids", "rule_record_ids", "reason_code", "evaluated_as_of"],
          "properties": {
            "schema_version": {"const": "tfc-rule-evidence-record-1.0"},
            "record_id": {"type": "string"},
            "record_type": {"const": "DESTINATION_SUPPORT"},
            "tfc_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$"},
            "country_code": {"$ref": "tfc-common.schema.json#/$defs/countryCode"},
            "support_status": {"enum": ["SUPPORTED", "EVIDENCE_INSUFFICIENT", "LEGALLY_BLOCKED", "STALE", "NOT_APPLICABLE_NATIONAL", "UNSUPPORTED"]},
            "jurisdiction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "rule_record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "reason_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]+$"},
            "evaluated_as_of": {"type": "string", "format": "date"}
          }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "condition_type", "field_id", "operator", "expected_value", "threshold_id"],
      "properties": {
        "condition_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "condition_type": {"enum": ["FIELD_PRESENT", "FIELD_ABSENT", "FIELD_EQUALS", "FIELD_IN_SET", "THRESHOLD", "RANGE", "TAXONOMY_MEMBERSHIP", "QUALIFICATION_LEVEL", "JURISDICTION", "CONDITIONAL_REQUIREMENT", "GROUP"]},
        "field_id": {"oneOf": [{"$ref": "tfc-common.schema.json#/$defs/fieldId"}, {"type": "null"}]},
        "operator": {"enum": ["PRESENT", "ABSENT", "EQ", "IN", "GTE", "GT", "LTE", "LT", "BETWEEN", "ANY_OF", "ALL_OF"]},
        "expected_value": {"oneOf": [{"type": ["string", "number", "boolean", "null"]}, {"type": "array", "items": {"type": ["string", "number", "boolean"]}}]},
        "threshold_id": {"type": ["string", "null"]},
        "blocking": {"type": "boolean"},
        "group_operator": {"enum": ["AND", "OR"]},
        "child_condition_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"}},
        "when": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["field_id", "operator", "expected_value"],
          "properties": {
            "field_id": {"$ref": "tfc-common.schema.json#/$defs/fieldId"},
            "operator": {"enum": ["PRESENT", "EQ"]},
            "expected_value": {"type": ["string", "number", "boolean", "null"]}
          }
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_id", "value", "unit"],
      "properties": {
        "threshold_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "routeRule": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "record_id", "record_type", "tfc_id", "route_id", "route_name", "jurisdiction_id", "overrides_record_id", "evaluation_boundary", "conditions", "thresholds", "effective_period", "source_references", "evidence_quality"],
          "properties": {
            "schema_version": {"const": "tfc-rule-evidence-record-1.0"},
            "record_id": {"type": "string"},
            "record_type": {"const": "ROUTE_RULE"},
            "tfc_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$"},
            "route_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
            "route_name": {"type": "string", "minLength": 1},
            "jurisdiction_id": {"type": "string"},
            "overrides_record_id": {"type": ["string", "null"]},
            "evaluation_boundary": {"enum": ["FULLY_MACHINE_EVALUABLE", "CONDITIONAL_EXTERNAL_CONFIRMATION_REQUIRED"]},
            "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
            "thresholds": {"type": "array", "items": {"$ref": "#/$defs/threshold"}},
            "effective_period": {"$ref": "#/$defs/period"},
            "source_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceReference"}},
            "evidence_quality": {"enum": ["HIGH", "MEDIUM", "LOW"]}
          }
        }
      ]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "field_id", "coefficient", "unit"],
      "properties": {
        "component_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
        "field_id": {"$ref": "tfc-common.schema.json#/$defs/fieldId"},
        "coefficient": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "metricFormula": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "record_id", "record_type", "tfc_id", "metric_id", "jurisdiction_id", "formula_type", "output_unit", "output_currency", "output_period", "rounding", "assumptions", "exchange_rate_policy", "locality_requirement", "components", "effective_period", "source_references", "evidence_quality"],
          "properties": {
            "schema_version": {"const": "tfc-rule-evidence-record-1.0"},
            "record_id": {"type": "string"},
            "record_type": {"const": "METRIC_FORMULA"},
            "tfc_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$"},
            "metric_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
            "jurisdiction_id": {"type": "string"},
            "formula_type": {"const": "WEIGHTED_SUM"},
            "output_unit": {"type": "string", "minLength": 1},
            "output_currency": {"oneOf": [{"$ref": "tfc-common.schema.json#/$defs/currencyCode"}, {"type": "null"}]},
            "output_period": {"enum": ["NONE", "HOURLY", "MONTHLY", "ANNUAL"]},
            "rounding": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "decimal_places"],
              "properties": {
                "mode": {"enum": ["HALF_UP", "NONE"]},
                "decimal_places": {"type": "integer", "minimum": 0, "maximum": 6}
              }
            },
            "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "exchange_rate_policy": {"enum": ["NONE", "REQUIRED_APPROVED_TABLE"]},
            "locality_requirement": {"enum": ["COUNTRY_ONLY", "OPTIONAL_TARGET_LOCALITY", "REQUIRED_TARGET_LOCALITY"]},
            "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
            "effective_period": {"$ref": "#/$defs/period"},
            "source_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceReference"}},
            "evidence_quality": {"enum": ["HIGH", "MEDIUM", "LOW"]}
          }
        }
      ]
    }
  }
}
