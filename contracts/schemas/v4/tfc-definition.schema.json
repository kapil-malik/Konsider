{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v4/tfc-definition.schema.json",
  "title": "Typed Feasibility Check definition 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "public_name", "compact_label", "source_criterion_ids", "product_role", "check_kind", "exact_construct", "user_question", "plain_language_meaning", "limitations", "input_requirements", "destination_evidence_policy_id", "evaluation_policy_id", "source_bundle_id", "result_schema_id", "scope", "supported_destination_codes", "supported_profile_boundary", "effective_date_policy_id", "refresh_policy_id", "filter_capability", "availability", "active", "sort_order", "documentation_ref"],
  "properties": {
    "id": {"$ref": "tfc-common.schema.json#/$defs/tfcId"},
    "public_name": {"type": "string", "minLength": 1},
    "compact_label": {"type": "string", "minLength": 1, "maxLength": 60},
    "source_criterion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[0-9]{2}$"}},
    "product_role": {"const": "TFC"},
    "check_kind": {"const": "RULE_ROUTE_MATCH"},
    "exact_construct": {"type": "string", "minLength": 1},
    "user_question": {"type": "string", "minLength": 1},
    "plain_language_meaning": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_requirements": {"type": "array", "minItems": 1, "items": {"$ref": "tfc-input-requirement.schema.json"}},
    "destination_evidence_policy_id": {"const": "tfc-destination-evidence-policy-1.0"},
    "evaluation_policy_id": {"const": "tfc-positive-conditional-route-policy-1.0"},
    "source_bundle_id": {"type": "string", "minLength": 1},
    "result_schema_id": {"const": "tfc-route-result-1.0"},
    "scope": {"enum": ["NATIONAL", "NATIONAL_WITH_REGIONAL_CONDITIONS"]},
    "supported_destination_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "tfc-common.schema.json#/$defs/countryCode"}},
    "supported_profile_boundary": {"type": "string", "minLength": 1},
    "effective_date_policy_id": {"const": "tfc-effective-date-policy-1.0"},
    "refresh_policy_id": {"const": "tfc-route-refresh-policy-1.0"},
    "filter_capability": {"enum": ["ASSESSMENT_ONLY", "EXPLICIT_SUPPORTED_ROUTE_FILTER_ALLOWED"]},
    "availability": {"enum": ["CONTRACT_ONLY", "STAGED", "AVAILABLE"]},
    "active": {"type": "boolean"},
    "sort_order": {"type": "integer", "minimum": 1},
    "documentation_ref": {"type": "string", "minLength": 1}
  }
}
