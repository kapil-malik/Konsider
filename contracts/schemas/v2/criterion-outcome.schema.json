{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v2/criterion-outcome.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["criterion_id", "country_code", "outcome", "source_id", "attempted_at", "observation_id", "reason_codes"],
  "properties": {
    "criterion_id": {"type": "string", "minLength": 1},
    "country_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "outcome": {"enum": ["valid", "missing", "stale", "invalid", "rejected"]},
    "source_id": {"type": "string", "minLength": 1},
    "attempted_at": {"type": "string", "format": "date-time"},
    "observation_id": {"type": ["string", "null"], "minLength": 1},
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Za-z0-9_.-]+)?$"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "valid"}}},
      "then": {
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "reason_codes": {"maxItems": 0}
        }
      },
      "else": {
        "properties": {
          "observation_id": {"type": "null"},
          "reason_codes": {"minItems": 1}
        }
      }
    }
  ]
}
