{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v2/release-manifest.schema.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "release_id", "status", "observation_count", "score_count",
    "attempt_count", "country_count", "country_codes", "criteria", "criterion_coverage",
    "coverage_policy_version", "file_checksums", "release_checksum", "validation_summary",
    "reproducibility", "scoring_method_versions", "source_versions"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^konsider-release-4\\.[0-9]+$"},
    "release_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "published"]},
    "observation_count": {"type": "integer", "minimum": 0},
    "score_count": {"type": "integer", "minimum": 0},
    "attempt_count": {"type": "integer", "minimum": 0},
    "country_count": {"type": "integer", "minimum": 1},
    "country_codes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]{3}$"}
    },
    "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "criterion_coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/coverage"}
    },
    "coverage_policy_version": {"const": "uncertainty-aware-ranking-policy-1.0"},
    "file_checksums": {
      "type": "object", "minProperties": 1,
      "required": ["observations.jsonl", "scores.jsonl", "attempts.jsonl", "sources.json", "validation.json"],
      "additionalProperties": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
    },
    "release_checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "validation_summary": {
      "type": "object",
      "required": ["criterion_readiness", "structural_passed", "global_core_ready_count", "minimum_global_core_count"],
      "properties": {
        "criterion_readiness": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "structural_passed": {"type": "boolean"},
        "global_core_ready_count": {"type": "integer", "minimum": 0},
        "minimum_global_core_count": {"type": "integer", "minimum": 0}
      }
    },
    "reproducibility": {"type": "object"},
    "scoring_method_versions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_versions": {"type": "object", "additionalProperties": {"type": "string"}}
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id", "mode", "stable_universe_id", "stable_country_count",
        "valid_country_count", "minimum_valid_country_count", "outcome_counts",
        "activation_threshold", "experimental", "source_versions",
        "scoring_method_version", "score_min", "score_max"
      ],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "mode": {"enum": ["GLOBAL_CORE", "CONDITIONAL_COMPLETE_CASE", "DIAGNOSTIC_ONLY"]},
        "stable_universe_id": {"type": "string", "minLength": 1},
        "stable_country_count": {"type": "integer", "minimum": 1},
        "valid_country_count": {"type": "integer", "minimum": 0},
        "minimum_valid_country_count": {"type": "integer", "minimum": 0},
        "outcome_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["valid", "missing", "stale", "invalid", "rejected"],
          "properties": {
            "valid": {"type": "integer", "minimum": 0},
            "missing": {"type": "integer", "minimum": 0},
            "stale": {"type": "integer", "minimum": 0},
            "invalid": {"type": "integer", "minimum": 0},
            "rejected": {"type": "integer", "minimum": 0}
          }
        },
        "activation_threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "experimental": {"type": "boolean"},
        "source_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
        "scoring_method_version": {"type": "string", "minLength": 1},
        "score_min": {"type": "number"},
        "score_max": {"type": "number"}
      }
    }
  }
}
