{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v5/release-manifest.schema.json",
  "title": "Konsider release 5.2 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "status", "catalog_schema_version", "validation_schema_version", "stable_universe_id", "country_entity_ids", "criteria", "criterion_coverage", "artifact_counts", "source_lineage_ids", "locality_universe_ids", "aggregation_policy_ids", "scoring_method_versions", "display_catalog", "display_metadata_equivalence", "opportunity_filters", "file_checksums", "release_checksum"],
  "properties": {
    "schema_version": {"const": "konsider-release-5.2"},
    "release_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "published"]},
    "catalog_schema_version": {"const": "consumer-catalog-4.0"},
    "validation_schema_version": {"const": "validation-5.0"},
    "stable_universe_id": {"type": "string", "minLength": 1},
    "country_entity_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^country:[A-Z]{3}$"}},
    "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "criterion_coverage": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "https://konsider.app/schemas/v3/criterion-definition.schema.json#/$defs/coverage"}},
    "artifact_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "source_lineage_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "locality_universe_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "aggregation_policy_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scoring_method_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "display_catalog": {"$ref": "#/$defs/displayCatalogBinding"},
    "display_metadata_equivalence": {"type": "object", "additionalProperties": false, "required": ["status", "definition_count", "report_checksum", "source_release_id"], "properties": {"status": {"const": "PASSED"}, "definition_count": {"const": 26}, "report_checksum": {"$ref": "#/$defs/checksum"}, "source_release_id": {"type": "string", "minLength": 1}}},
    "opportunity_filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_schema_version", "state_contract_version", "artifacts"],
      "properties": {
        "binding_schema_version": {"const": "opportunity-filter-release-binding-2.0"},
        "state_contract_version": {"const": "opportunity-filter-state-1.0"},
        "artifacts": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "filename", "schema_version", "checksum"],
            "properties": {
              "role": {"enum": ["CATALOG", "COUNTRY_EVIDENCE", "SOURCE_MANIFEST", "THRESHOLD_POLICIES", "EVIDENCE_POLICY", "COVERAGE_SUMMARY"]},
              "filename": {"type": "string", "minLength": 1},
              "schema_version": {"type": "string", "minLength": 1},
              "checksum": {"$ref": "#/$defs/checksum"}
            }
          }
        }
      }
    },
    "file_checksums": {"type": "object", "minProperties": 17, "additionalProperties": {"$ref": "#/$defs/checksum"}},
    "release_checksum": {"$ref": "#/$defs/checksum"}
  },
  "$defs": {
    "checksum": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "displayCatalogBinding": {"type": "object", "additionalProperties": false, "required": ["schema_version", "catalog_version", "checksum"], "properties": {"schema_version": {"const": "konsider-product-display-catalog-1.0"}, "catalog_version": {"type": "string", "minLength": 1}, "checksum": {"$ref": "#/$defs/checksum"}}}
  }
}
