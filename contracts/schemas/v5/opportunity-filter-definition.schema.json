{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v5/opportunity-filter-definition.schema.json",
  "title": "Opportunity Filter definition 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "compactName", "sectionId", "sectionName", "sortOrder", "construct", "meaning", "does_not_mean", "product_role", "state_contract_version", "filter_behavior", "evidence_policy_version", "threshold_policy_version", "source_bundle_version", "scope", "applicability", "refresh_policy", "source_dependency", "availability", "active", "documentation_ref"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*_opportunity$"},
    "displayName": {"type": "string", "minLength": 1},
    "compactName": {"type": ["string", "null"], "minLength": 1},
    "sectionId": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
    "sectionName": {"type": ["string", "null"], "minLength": 1},
    "sortOrder": {"type": "integer", "minimum": 0},
    "construct": {"type": "string", "minLength": 1},
    "meaning": {"type": "string", "minLength": 1},
    "does_not_mean": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "product_role": {"const": "OPPORTUNITY_FILTER"},
    "state_contract_version": {"const": "opportunity-filter-state-1.0"},
    "filter_behavior": {"$ref": "https://konsider.app/schemas/v3/opportunity-filter-definition.schema.json#/properties/filter_behavior"},
    "evidence_policy_version": {"type": "string", "minLength": 1},
    "threshold_policy_version": {"type": "string", "minLength": 1},
    "source_bundle_version": {"type": "string", "minLength": 1},
    "scope": {"$ref": "https://konsider.app/schemas/v3/opportunity-filter-definition.schema.json#/properties/scope"},
    "applicability": {"$ref": "https://konsider.app/schemas/v3/opportunity-filter-definition.schema.json#/properties/applicability"},
    "refresh_policy": {"$ref": "https://konsider.app/schemas/v3/opportunity-filter-definition.schema.json#/properties/refresh_policy"},
    "source_dependency": {"$ref": "https://konsider.app/schemas/v3/opportunity-filter-definition.schema.json#/properties/source_dependency"},
    "availability": {"enum": ["STAGED", "AVAILABLE", "WITHDRAWN"]},
    "active": {"type": "boolean"},
    "documentation_ref": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"active": {"const": true}}, "required": ["active"]},
      "then": {"properties": {"availability": {"const": "AVAILABLE"}}}
    },
    {
      "if": {"properties": {"sectionId": {"type": "string"}}, "required": ["sectionId"]},
      "then": {"properties": {"sectionName": {"type": "string"}}},
      "else": {"properties": {"sectionName": {"type": "null"}}}
    }
  ]
}
