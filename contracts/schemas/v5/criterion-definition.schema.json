{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v5/criterion-definition.schema.json",
  "title": "Ordering criterion definition 4.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "compactName", "sectionId", "sectionName", "sortOrder", "historical_names", "description", "direction", "raw_unit", "interpretation", "caveats", "quality_limitations", "ready", "default_enabled", "experimental", "scoring_method_version", "coverage", "scope", "applicability"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "displayName": {"type": "string", "minLength": 1},
    "compactName": {"type": ["string", "null"], "minLength": 1},
    "sectionId": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
    "sectionName": {"type": ["string", "null"], "minLength": 1},
    "sortOrder": {"type": "integer", "minimum": 0},
    "historical_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "description": {"type": "string", "minLength": 1},
    "direction": {"enum": ["higher_is_better", "lower_is_better"]},
    "raw_unit": {"type": "string", "minLength": 1},
    "interpretation": {"type": "string", "minLength": 1},
    "caveats": {"type": "array", "items": {"type": "string"}},
    "quality_limitations": {"type": "array", "items": {"type": "string"}},
    "ready": {"type": "boolean"},
    "default_enabled": {"type": "boolean"},
    "experimental": {"type": "boolean"},
    "scoring_method_version": {"type": "string", "minLength": 1},
    "coverage": {"$ref": "https://konsider.app/schemas/v3/criterion-definition.schema.json#/$defs/coverage"},
    "scope": {"$ref": "https://konsider.app/schemas/v3/criterion-definition.schema.json#/$defs/scope"},
    "applicability": {"$ref": "https://konsider.app/schemas/v3/criterion-definition.schema.json#/$defs/applicability"}
  },
  "allOf": [{"if": {"properties": {"sectionId": {"type": "string"}}, "required": ["sectionId"]}, "then": {"properties": {"sectionName": {"type": "string"}}}, "else": {"properties": {"sectionName": {"type": "null"}}}}]
}
