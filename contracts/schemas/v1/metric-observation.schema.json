{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v1/metric-observation.schema.json",
  "type": "object",
  "required": ["observation_id", "country_code", "metric_id", "value", "unit", "reference_start", "reference_end", "source_id", "raw_artifact_ids", "source_records", "observation_type", "geographic_scope", "parser_version", "method_version", "quality_flags"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1}, "country_code": {"type": "string", "pattern": "^[A-Z]{3}$"}, "metric_id": {"type": "string", "minLength": 1},
    "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "reference_start": {"type": "string", "format": "date"}, "reference_end": {"type": "string", "format": "date"},
    "source_id": {"type": "string", "minLength": 1}, "raw_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^sha256:[a-f0-9]+$"}},
    "source_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRecord"}}, "observation_type": {"type": "string"}, "geographic_scope": {"type": "string"},
    "parser_version": {"type": "string", "minLength": 1}, "method_version": {"type": "string", "minLength": 1}, "quality_flags": {"type": "array", "items": {"type": "string"}},
    "lower_bound": {"type": ["number", "null"]}, "upper_bound": {"type": ["number", "null"]},
    "components": {"type": "array", "items": {"type": "object", "required": ["component_id", "value", "unit", "reference_year", "source_record"], "properties": {"component_id": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}, "reference_year": {"type": "integer", "minimum": 1900}, "source_record": {"$ref": "#/$defs/sourceRecord"}}}}
  },
  "$defs": {"sourceRecord": {"type": "object", "required": ["artifact_id", "locator", "record_id"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "record_id": {"type": "string", "minLength": 1}}}}
}
