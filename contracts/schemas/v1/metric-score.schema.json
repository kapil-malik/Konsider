{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://konsider.app/schemas/v1/metric-score.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["country_code", "criterion_id", "score", "input_observation_ids", "method_version", "transform", "direction"],
  "properties": {
    "country_code": {"type": "string", "pattern": "^[A-Z]{3}$"}, "criterion_id": {"type": "string", "minLength": 1}, "score": {"type": "number", "minimum": 1, "maximum": 10},
    "input_observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "method_version": {"type": "string", "minLength": 1},
    "transform": {"type": "string", "minLength": 1}, "direction": {"enum": ["higher_is_better", "lower_is_better"]}
  }
}
